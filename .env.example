# ---------------------------------------------------------------------------
# OwnAI configuration. Copy to .env and adjust. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- security (REQUIRED) ---------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
OWNAI_SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OWNAI_ENCRYPTION_KEY=
OWNAI_ALLOW_REGISTRATION=true
# set true when serving over HTTPS
OWNAI_COOKIE_SECURE=false

# --- runtime -----------------------------------------------------------------
OWNAI_APP_ENV=development
OWNAI_LOG_LEVEL=INFO
OWNAI_LOG_JSON=true
# worker = separate worker process via Redis (recommended); inline = single process (dev only)
OWNAI_EXECUTION_MODE=worker
OWNAI_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- storage -------------------------------------------------------------------
OWNAI_DATABASE_URL=postgresql+asyncpg://ownai:ownai@localhost:5432/ownai
OWNAI_REDIS_URL=redis://localhost:6379/0
OWNAI_QDRANT_URL=http://localhost:6333
# OWNAI_QDRANT_API_KEY=
OWNAI_PROJECTS_ROOT=./data/projects
# Comma-separated directories users may import from by path (empty disables local imports)
OWNAI_LOCAL_IMPORT_ROOTS=
OWNAI_MAX_UPLOAD_MB=200

# --- models ----------------------------------------------------------------------
# Option A (recommended): a model registry file (see config/models.example.yaml)
OWNAI_MODELS_CONFIG_PATH=config/models.yaml
# Variables referenced by config/models.example.yaml (vLLM):
FAST_MODEL_URL=http://localhost:8001/v1
FAST_MODEL_NAME=
CODING_MODEL_URL=http://localhost:8002/v1
CODING_MODEL_NAME=
REASONING_MODEL_URL=http://localhost:8003/v1
REASONING_MODEL_NAME=
EMBEDDING_MODEL_URL=http://localhost:8004/v1
EMBEDDING_MODEL_NAME=
EMBEDDING_DIMENSIONS=
# Option B: a single OpenAI-compatible model (leave OWNAI_MODELS_CONFIG_PATH empty)
# OWNAI_MODEL_PROVIDER=openai_compatible   # openai_compatible | vllm | ollama
# OWNAI_MODEL_URL=http://localhost:8000/v1
# OWNAI_MODEL_NAME=
# OWNAI_MODEL_API_KEY=
# OWNAI_EMBEDDING_URL=http://localhost:8004/v1
# OWNAI_EMBEDDING_MODEL=
# OWNAI_EMBEDDING_DIMENSIONS=
OWNAI_MODEL_REQUEST_TIMEOUT_S=180
OWNAI_MODEL_HEALTH_INTERVAL_S=30

# --- sandbox -----------------------------------------------------------------------
OWNAI_SANDBOX_URL=http://localhost:8090
# must equal SANDBOX_TOKEN of the sandbox runner
OWNAI_SANDBOX_TOKEN=
SANDBOX_TOKEN=

# --- billing (optional) ----------------------------------------------------------------
OWNAI_BILLING_ENABLED=false
OWNAI_DEFAULT_PLAN=private
# OWNAI_PLANS_CONFIG_PATH=config/plans.yaml
